# ============================================================
# Athena Knowledge Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your local values.
# .env is git-ignored. Do NOT commit real secrets here.

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:5432/athena_dev
DATABASE_TEST_URL=postgresql+asyncpg://athena:athena@localhost:5432/athena_test

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Elasticsearch
# ============================================================
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme

# ============================================================
# Neo4j
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=athenadev

# ============================================================
# MinIO / S3-compatible Object Storage
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=athena-dev
S3_REGION=us-east-1

# ============================================================
# AI Providers (optional for local dev)
# ============================================================
# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG_ID=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Local Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# JWT / Authentication
# ============================================================
JWT_SECRET=dev-secret-change-in-production-use-256-bit-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# API Gateway
# ============================================================
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_ANON=100
API_RATE_LIMIT_USER=1000

# ============================================================
# Application
# ============================================================
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text

# Sentry (error tracking, optional)
SENTRY_DSN=

# ============================================================
# Email (optional for local dev)
# ============================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@athena.local
